var current_locale: String = DEFAULT_LOCALE
var _initialized := false

func _enter_tree() -> void:
	init_localization()

func init_localization() -> void:
	if _initialized:
		return
	_initialized = true
	_register_translations_to_godot()
	_load_saved_locale()

## Đăng ký dữ liệu từ điển vào TranslationServer của Godot
func _register_translations_to_godot() -> void:
	var trans_objects: Dictionary = {}
	for lang in SUPPORTED_LANGUAGES:
		var code: String = lang["code"]
		var tr_res := Translation.new()
		tr_res.locale = code
		trans_objects[code] = tr_res

	for key in TRANSLATIONS.keys():
		var row: Dictionary = TRANSLATIONS[key]
		for code in trans_objects.keys():
			var val: String = row.get(code, key)
			trans_objects[code].add_message(key, val)

	for code in trans_objects.keys():
		TranslationServer.add_translation(trans_objects[code])

func _load_saved_locale() -> void:
	var cfg := ConfigFile.new()
	var loc := DEFAULT_LOCALE
	if cfg.load(SETTINGS_PATH) == OK:
		loc = str(cfg.get_value("general", "locale", DEFAULT_LOCALE))
	if not is_supported_locale(loc):
		loc = DEFAULT_LOCALE
	current_locale = loc
	TranslationServer.set_locale(current_locale)

func set_locale(loc: String, save: bool = true) -> void:
	if not is_supported_locale(loc):
		loc = DEFAULT_LOCALE
	current_locale = loc
	TranslationServer.set_locale(current_locale)
	if save:
		var cfg := ConfigFile.new()
		cfg.load(SETTINGS_PATH)
		cfg.set_value("general", "locale", current_locale)
		cfg.save(SETTINGS_PATH)
	locale_changed.emit(current_locale)

func get_locale() -> String:
	return current_locale

func is_supported_locale(code: String) -> bool:
	for l in SUPPORTED_LANGUAGES:
		if l["code"] == code:
			return true
	return false

func get_supported_languages() -> Array[Dictionary]:
	return SUPPORTED_LANGUAGES

func get_language_display_name(code: String) -> String:
	for l in SUPPORTED_LANGUAGES:
		if l["code"] == code:
			return l.get("display", l.get("name", code))
	return code
