static func get_skills_by_filter(element_filter: String = "", tier_filter: int = 0) -> Array[Dictionary]:
	var result: Array[Dictionary] = []
	for s in get_all_skills():
		if element_filter != "" and element_filter != "Tất cả":
			if str(s.get("element", "")) != element_filter and str(s.get("sect", "")) != element_filter:
				continue
		if tier_filter > 0:
			var req := int(s.get("req_level", 10))
			var skill_tier := int(req / 10)
			if tier_filter == 4:
				if skill_tier < 4:
					continue
			else:
				if skill_tier != tier_filter:
					continue
		result.append(s)
	return result

static func get_skill(id: String) -> Dictionary:
	for s in get_all_skills():
		if str(s["id"]) == id:
			return s.duplicate(true)
	return {}

## Tải texture biểu tượng kỹ năng an toàn, có cơ chế fallback tự động nếu thiếu file
static func get_skill_icon_texture(s: Dictionary) -> Texture2D:
	var ipath := str(s.get("icon", ""))
	if ResourceLoader.exists(ipath):
		return load(ipath)
	var fallbacks: Array[String] = [
		ipath.replace("xung_kich", "duong_mon_thuong_phap"),
		ipath.replace("xung_kich", "long_dieu_xung_phong"),
		"res://assets/skill_icons/vltk/duong_gia_duong_mon_thuong_phap.png",
		"res://assets/skill_icons/vltk/duong_gia_long_dieu_xung_phong.png",
		"res://assets/skill_icons/vltk/cai_bang_phi_long_tai_thien.png",
		"res://assets/skill_icons/vltk/thieu_lam_la_han_tran.png"
	]
	for fb in fallbacks:
		if ResourceLoader.exists(fb):
			return load(fb)
	return null

## Tạo khung hiển thị ảnh/avatar nhân vật đại diện cho kỹ năng môn phái (SubViewportContainer)
static func create_hero_avatar_preview(s: Dictionary, size: Vector2 = Vector2(64, 60), scale_factor: float = 0.38) -> Control:
	var svc := SubViewportContainer.new()
	svc.custom_minimum_size = size
	svc.size = size
	svc.stretch = true
	svc.mouse_filter = Control.MOUSE_FILTER_IGNORE

	var unit_type := int(s.get("type", UnitType.LINE_PROJECTILE))
	if unit_type == UnitType.CHEST_UTILITY:
		var ico := TextureRect.new()
		var ipath := str(s.get("icon", ""))
		if ResourceLoader.exists(ipath):
			ico.texture = load(ipath)
		ico.set_anchors_preset(Control.PRESET_FULL_RECT)
		ico.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
		ico.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
		ico.mouse_filter = Control.MOUSE_FILTER_IGNORE
		return ico

	var vp := SubViewport.new()
	vp.size = Vector2i(int(size.x), int(size.y))
	vp.transparent_bg = true
	vp.gui_disable_input = true
	svc.add_child(vp)

	var av_data: Dictionary = s.get("avatar", {})
	const CharacterAvatarScript = preload("res://systems/avatar/character_avatar.gd")
	if CharacterAvatarScript:
		var ca: CharacterAvatar = CharacterAvatarScript.new()
		ca.gender = str(av_data.get("gender", "male"))
		ca.helm_res = int(av_data.get("helm", -1))
		ca.armor_res = int(av_data.get("armor", -1))
		ca.weapon_res = int(av_data.get("weapon", -1))
		ca.horse_res = int(av_data.get("horse", -1)) if bool(av_data.get("riding", false)) else -1
		ca.direction = 6
		vp.add_child(ca)
		ca.position = Vector2(size.x * 0.5, size.y - 4.0)
		ca.scale = Vector2(scale_factor, scale_factor)
		ca.play("stand")
		ca.face(Vector2.RIGHT)

	return svc


