extends RefCounted
class_name ThuThanhSkillData

## DỮ LIỆU KỸ NĂNG & NHÂN VẬT THỦ THÀNH (PLANTS VS ZOMBIES JX1)
## Quản lý toàn bộ danh sách kỹ năng, giá Xu, thời gian hồi, chỉ số chiến đấu
## và ngoại hình Avatar CỐ ĐỊNH (không tạo lại ở runtime).

enum UnitType {
	WALL,              ## Đỡ đòn cản đường (Thiếu Lâm - Wall-nut)
	LINE_PROJECTILE,   ## Bắn chưởng/đạn theo hàng thẳng (Cái Bang, Đường Môn, Hoa Sơn)
	LINE_SLOW,         ## Băng sát làm chậm quái 50% (Thúy Yên - Snow Pea)
	LINE_POISON,       ## Độc sát rút máu theo thời gian (Ngũ Độc)
	LIGHTNING_TARGET,  ## Sấm sét giáng từ trên cao (Côn Lôn)
	STUN_PROJECTILE,   ## Kiếm khí định thân/choáng quái (Võ Đang)
	BOMB_INSTANT,      ## Bom nổ bộc phá diện rộng quét sạch làn quái (Thiên Nhẫn - Cherry Bomb)
	HEAL_SUPPORT,      ## Hồi phục sinh lực đồng đội và Xe Tống Kim (Nga Mi)
	CLEAVE_MELEE,      ## Kỵ sĩ đánh lan càn quét cận chiến (Dương Gia, Thiên Vương)
	CHEST_UTILITY      ## Rương quân nhu trợ chiến (Quân Nhu)
}

const TOTAL_SLOTS := 14
const BONUS_STARTING_COINS := 150

## Số ô được mở theo cấp bản đồ (1x -> 5, 2x -> 6, ..., 10x+ -> 14)
static func get_unlocked_slots_for_tier(map_tier: int) -> int:
	var t := clampi(map_tier, 1, 10)
	return clampi(4 + t, 5, TOTAL_SLOTS)

## Công thức tính Xu khởi đầu: Tổng giá Xu của 3 kỹ năng đắt nhất trong danh sách kỹ năng đã chọn + 150 Xu thưởng
static func calculate_starting_coins(selected_skill_ids: Array) -> int:
	var costs: Array[int] = []
	for sid in selected_skill_ids:
		var s := get_skill(str(sid))
		if not s.is_empty():
			costs.append(int(s.get("cost", 50)))
	costs.sort()
	costs.reverse()
	var total := 0
	var count := mini(3, costs.size())
	for i in count:
		total += costs[i]
	if not costs.is_empty():
		total += BONUS_STARTING_COINS
	return total

const PREBAKED_AVATAR_PATH := "res://data/thu_thanh/prebaked_avatars.json"
const THU_THANH_SAVE_FILE := "user://thu_thanh_save.json"
const MAX_THU_THANH_LEVEL := 150

static var _skills_cache: Array[Dictionary] = []
static var _saved_level: int = 10
static var _saved_exp: int = 0
static var _saved_skill_levels: Dictionary = {}
static var _saved_skill_points: int = 10
static var _saved_selected_skills: Array[String] = []
static var _is_progress_loaded: bool = false

## Xác định phân tầng cấp độ (Tier) của kỹ năng (1 = 1x, 9 = 9x Trấn Phái, 12 = 12x Bí Kíp, 15 = 15x Tối Thượng)
static func get_skill_tier(skill_id: String) -> int:
	var s := get_skill(skill_id)
	var req_lvl := int(s.get("req_level", 10))
	var tier := int(req_lvl / 10)
	return clampi(tier, 1, 15)

## Cấp độ kỹ năng tối đa (Max Skill Level):
## - Cấp 1x - 8x: Cấp tối đa 20
## - Cấp 9x Trấn Phái: Cấp tối đa 20 (với hiệu ứng Trấn Phái uy lực vượt bậc khi đạt MAX)
## - Cấp 12x Bí Kíp: Cấp tối đa 20 (với bộc phá song song khi đạt MAX)
## - Cấp 15x Tối Thượng: Cấp tối đa 20 (với thần kỹ hủy diệt toàn màn hình khi đạt MAX)
static func get_max_skill_level(skill_id: String) -> int:
	var tier := get_skill_tier(skill_id)
	if tier >= 9:
		return 20
	return 20

## Chỉ số tỷ lệ tăng tiến sát thương & hiệu ứng theo cấp kỹ năng:
## Kỹ năng 9x, 12x, 15x tăng tiến vượt trội hơn hẳn kỹ năng 1x!
static func get_skill_scaling(skill_id: String, level: int) -> Dictionary:
	var s := get_skill(skill_id)
	var tier := get_skill_tier(skill_id)
	var max_lvl := get_max_skill_level(skill_id)
	var cur_lvl := clampi(level, 1, max_lvl)
	var is_max := (cur_lvl >= max_lvl)
	var u_type: int = int(s.get("type", UnitType.LINE_PROJECTILE))
	var proj_type: String = str(s.get("projectile_type", ""))

	var pct_per_lvl := 10 # 1x tăng 10%/cấp
	if tier >= 15:
		pct_per_lvl = 30 # 15x Tối Thượng tăng 30%/cấp
	elif tier >= 12:
		pct_per_lvl = 25 # 12x Bí Kíp tăng 25%/cấp
	elif tier >= 9:
		pct_per_lvl = 20 # 9x Trấn Phái tăng 20%/cấp
	elif tier >= 5:
		pct_per_lvl = 15 # 5x-8x tăng 15%/cấp
	elif tier >= 2:
		pct_per_lvl = 12 # 2x-4x tăng 12%/cấp

	var base_mult := 1.0 + (cur_lvl - 1) * (float(pct_per_lvl) / 100.0)
	var aoe_mult := 1.0 + (cur_lvl - 1) * 0.02

	# TĂNG TIẾN SỐ ĐẠN / SỐ RỒNG THEO CẤP CHUẨN VLTK:
	# Cấp 1-4: 1 đạn/rồng
	# Cấp 5-9: 2 đạn/rồng (extra = 1)
	# Cấp 10-14: 3 đạn/rồng (extra = 2)
	# Cấp 15-19: 4 đạn/rồng (extra = 3)
	# Cấp 20 (MAX): 5 đạn/rồng liên hoàn (extra = 4)!
	var extra_shots := 0
	if u_type == UnitType.LINE_PROJECTILE:
		extra_shots = int(cur_lvl / 5)

	var special_desc := ""

	# KHÁC BIỆT RÕ RỆT KHI CỘNG MAX SKILL GIỮA 1x VÀ 9x/12x/15x
	if is_max:
		if tier >= 15:
			# 15x Tối Thượng khi Max: Sát thương x1.5 thêm, bán kính nổ x1.8, uy lực thần thánh
			base_mult *= 1.5
			aoe_mult *= 1.8
			if u_type == UnitType.LINE_PROJECTILE:
				extra_shots = 6 # Tổng 7 đạn/rồng
			special_desc = "🌟 [TRẤN PHÁI TỐI THƯỢNG] Sát thương hủy diệt x1.5, nổ lan bão lốc toàn hàng, xuất 7 đạo kình khí liên hoàn!"
		elif tier >= 12:
			# 12x Bí Kíp khi Max: Sát thương x1.35 thêm, bắn liên hoàn cực đại
			base_mult *= 1.35
			aoe_mult *= 1.5
			if u_type == UnitType.LINE_PROJECTILE:
				extra_shots = 5 # Tổng 6 đạn/rồng
			special_desc = "🔥 [BÍ KÍP TUYỆT THẾ] Sát thương x1.35, phóng 6 luồng kình khí liên hoàn xuyên thấu quái!"
		elif tier >= 9:
			# 9x Trấn Phái khi Max: Sát thương x1.3 thêm, bán kính AoE x1.4
			base_mult *= 1.3
			aoe_mult *= 1.4
			if u_type == UnitType.LINE_PROJECTILE:
				extra_shots = 4 # Tổng 5 đạn/rồng
			special_desc = "👑 [TRẤN PHÁI UY LỰC] Sát thương bộc phá x1.3, phạm vi nổ lan x1.4, phóng 5 luồng kình chấn động càn quét quân địch!"
		else:
			if u_type == UnitType.LINE_PROJECTILE:
				extra_shots = 4 # Tổng 5 đạn/rồng
			if proj_type == "dragon" or skill_id == "cai_bang":
				special_desc = "🐉 [PHI LONG TẠI THIÊN MAX] Bắn 5 Thần Long Hỏa Diệm uốn lượn liên hoàn dí quái (+%d%% Sát thương)!" % int((base_mult - 1.0) * 100)
			else:
				special_desc = "⚔️ [THUẦN THỤC CỰC HẠN] Uy lực kỹ năng đạt cảnh giới cao nhất (+%d%% Sát thương cơ bản, xuất 5 đạn liên hoàn)." % int((base_mult - 1.0) * 100)

	return {
		"level": cur_lvl,
		"max_level": max_lvl,
		"is_max": is_max,
		"percent_per_lvl": pct_per_lvl,
		"damage_mult": base_mult,
		"aoe_mult": aoe_mult,
		"extra_shots": extra_shots,
		"special_desc": special_desc
	}

static func _get_game_manager() -> Node:
	var loop := Engine.get_main_loop() as SceneTree
	if loop != null and loop.root != null and loop.root.has_node("GameManager"):
		return loop.root.get_node("GameManager")
	return null

static func _get_save_manager() -> Node:
	var loop := Engine.get_main_loop() as SceneTree
	if loop != null and loop.root != null and loop.root.has_node("SaveManager"):
		return loop.root.get_node("SaveManager")
	return null

## Nạp tiến độ nâng cấp kỹ năng & điểm kỹ năng (thừa hưởng qua mọi Map)
static func load_progress() -> void:
	if _is_progress_loaded and not _saved_skill_levels.is_empty():
		return

	_is_progress_loaded = true

	# 1. Thử nạp từ PlayerProfile nếu có đăng nhập
	var gm := _get_game_manager()
	if gm != null and "local_profile" in gm and gm.local_profile != null:
		var prof = gm.local_profile
		if "thu_thanh_level" in prof:
			_saved_level = maxi(1, int(prof.thu_thanh_level))
		if "thu_thanh_exp" in prof:
			_saved_exp = maxi(0, int(prof.thu_thanh_exp))
		if "thu_thanh_skill_levels" in prof and prof.thu_thanh_skill_levels is Dictionary and not prof.thu_thanh_skill_levels.is_empty():
			_saved_skill_levels = prof.thu_thanh_skill_levels.duplicate()
			_saved_skill_points = int(prof.thu_thanh_skill_points)
			if "thu_thanh_selected_skills" in prof and prof.thu_thanh_selected_skills is Array:
				_saved_selected_skills.clear()
				for sid in prof.thu_thanh_selected_skills:
					var sid_str := str(sid)
					if sid_str != "quan_nhu" and sid_str != "":
						_saved_selected_skills.append(sid_str)
			return

	# 2. Thử nạp từ file lưu trữ user://
	if FileAccess.file_exists(THU_THANH_SAVE_FILE):
		var text := FileAccess.get_file_as_string(THU_THANH_SAVE_FILE)
		var parsed = JSON.parse_string(text)
		if parsed is Dictionary:
			if parsed.has("level"):
				_saved_level = maxi(1, int(parsed["level"]))
			if parsed.has("exp"):
				_saved_exp = maxi(0, int(parsed["exp"]))
			if parsed.has("skill_levels") and parsed["skill_levels"] is Dictionary:
				_saved_skill_levels = parsed["skill_levels"].duplicate()
			if parsed.has("skill_points"):
				_saved_skill_points = int(parsed["skill_points"])
			if parsed.has("selected_skills") and parsed["selected_skills"] is Array:
				_saved_selected_skills.clear()
				for sid in parsed["selected_skills"]:
					var sid_str := str(sid)
					if sid_str != "quan_nhu" and sid_str != "":
						_saved_selected_skills.append(sid_str)
			return

	# Khởi tạo mặc định nếu chưa từng lưu (Bắt đầu Cấp 10, 10 điểm kỹ năng cho hàng 1x)
	if _saved_skill_levels.is_empty():
		_saved_level = 10
		_saved_exp = 0
		_saved_skill_levels = {}
		_saved_skill_points = 10

## Lưu tiến độ kỹ năng xuống PlayerProfile và File bộ nhớ
static func save_progress() -> void:
	# Lưu vào PlayerProfile
	var gm := _get_game_manager()
	if gm != null and "local_profile" in gm and gm.local_profile != null:
		var prof = gm.local_profile
		prof.set("thu_thanh_level", _saved_level)
		prof.set("thu_thanh_exp", _saved_exp)
		prof.set("thu_thanh_skill_levels", _saved_skill_levels.duplicate())
		prof.set("thu_thanh_skill_points", _saved_skill_points)
		prof.set("thu_thanh_selected_skills", _saved_selected_skills.duplicate())
		var sm := _get_save_manager()
		if sm != null and sm.has_method("save_profile"):
			sm.save_profile(prof)

	# Lưu vào file JSON user://
	var save_data := {
		"level": _saved_level,
		"exp": _saved_exp,
		"skill_levels": _saved_skill_levels,
		"skill_points": _saved_skill_points,
		"selected_skills": _saved_selected_skills,
		"saved_at": Time.get_datetime_string_from_system()
	}
	var f := FileAccess.open(THU_THANH_SAVE_FILE, FileAccess.WRITE)
	if f != null:
		f.store_string(JSON.stringify(save_data, "\t"))
		f.close()

## Lấy cấp độ hiện tại của chế độ Thủ Thành (Zombies vs Plants)
static func get_thu_thanh_level() -> int:
	load_progress()
	return _saved_level

## Lấy EXP hiện tại của chế độ Thủ Thành
static func get_thu_thanh_exp() -> int:
	load_progress()
	return _saved_exp

## Đặt trực tiếp Cấp độ Thủ Thành (phục vụ test / đồng bộ)
static func set_thu_thanh_level(lvl: int) -> void:
	load_progress()
	_saved_level = clampi(lvl, 1, MAX_THU_THANH_LEVEL)
	save_progress()

## Đặt trực tiếp EXP Thủ Thành
static func set_thu_thanh_exp(xp: int) -> void:
	load_progress()
	_saved_exp = maxi(0, xp)
	save_progress()

## Lượng EXP cần thiết để tăng từ cấp hiện tại lên cấp tiếp theo
static func get_exp_to_next_level(lvl: int = -1) -> int:
	var l := _saved_level if lvl <= 0 else lvl
	return int(200 + (l - 1) * 35)

## Cộng EXP riêng cho chế độ Zombies vs Plants:
## Tăng 1 level -> được cộng ngay 10 điểm kỹ năng!
static func add_thu_thanh_exp(amount: int) -> Dictionary:
	load_progress()
	if amount <= 0 or _saved_level >= MAX_THU_THANH_LEVEL:
		return {
			"leveled_up": false,
			"old_level": _saved_level,
			"new_level": _saved_level,
			"levels_gained": 0,
			"current_exp": _saved_exp,
			"max_exp": get_exp_to_next_level(_saved_level),
			"skill_points_gained": 0
		}

	var old_lvl := _saved_level
	_saved_exp += amount
	var levels_gained := 0

	while _saved_level < MAX_THU_THANH_LEVEL and _saved_exp >= get_exp_to_next_level(_saved_level):
		_saved_exp -= get_exp_to_next_level(_saved_level)
		_saved_level += 1
		levels_gained += 1
		_saved_skill_points += 10 # Tăng 1 level được cộng vào 10 điểm kỹ năng!

	if _saved_level >= MAX_THU_THANH_LEVEL:
		_saved_exp = 0

	save_progress()

	return {
		"leveled_up": levels_gained > 0,
		"old_level": old_lvl,
		"new_level": _saved_level,
		"levels_gained": levels_gained,
		"current_exp": _saved_exp,
		"max_exp": get_exp_to_next_level(_saved_level),
		"skill_points_gained": levels_gained * 10
	}

static func get_saved_selected_skills() -> Array[String]:
	load_progress()
	return _saved_selected_skills.duplicate()

static func save_selected_skills(skills: Array[String]) -> void:
	load_progress()
	_saved_selected_skills.clear()
	for sid in skills:
		_saved_selected_skills.append(str(sid))
	save_progress()

static func get_skill_level(skill_id: String) -> int:
	load_progress()
	return int(_saved_skill_levels.get(skill_id, 1))

static func set_skill_level(skill_id: String, level: int) -> void:
	load_progress()
	var max_lvl := get_max_skill_level(skill_id)
	_saved_skill_levels[skill_id] = clampi(level, 1, max_lvl)
	save_progress()

static func get_all_saved_skill_levels() -> Dictionary:
	load_progress()
	return _saved_skill_levels.duplicate()

static func get_skill_points() -> int:
	load_progress()
	return _saved_skill_points

static func set_skill_points(pts: int) -> void:
	load_progress()
	_saved_skill_points = maxi(0, pts)
	save_progress()

static func add_skill_points(pts: int) -> void:
	load_progress()
	_saved_skill_points = maxi(0, _saved_skill_points + pts)
	save_progress()

## Kiểm tra xem có thể cộng điểm cho kỹ năng không:
## Yêu cầu:
## 1. Còn điểm kỹ năng khả dụng (_saved_skill_points > 0)
## 2. Kỹ năng chưa đạt cấp tối đa
## 3. RÀNG BUỘC CẤP ĐỘ: Cấp Thủ Thành hiện tại (_saved_level) phải >= Cấp yêu cầu của kỹ năng (req_level)
##    (Ví dụ: Cấp 70 thì chỉ cộng cho các skill cấp 70 trở xuống)
static func can_upgrade_skill(skill_id: String) -> Dictionary:
	load_progress()
	var s := get_skill(skill_id)
	if s.is_empty():
		return {"can_upgrade": false, "reason": "Kỹ năng không tồn tại"}

	var req_lvl := int(s.get("req_level", 10))
	if _saved_level < req_lvl:
		return {
			"can_upgrade": false,
			"reason": "Chưa đủ Cấp Thủ Thành! Cần Cấp %d (Hiện tại: Cấp %d)" % [req_lvl, _saved_level],
			"need_level": req_lvl
		}

	var max_lvl := get_max_skill_level(skill_id)
	var cur_lvl: int = int(_saved_skill_levels.get(skill_id, 1))
	if cur_lvl >= max_lvl:
		return {"can_upgrade": false, "reason": "Kỹ năng đã đạt cấp tối đa MAX"}

	if _saved_skill_points <= 0:
		return {"can_upgrade": false, "reason": "Không đủ điểm kỹ năng Thủ Thành"}

	return {"can_upgrade": true, "reason": "Có thể nâng cấp"}

## Nâng cấp 1 kỹ năng: kiểm tra điểm khả dụng & giới hạn Max cấp & giới hạn Cấp Thủ Thành
static func upgrade_skill(skill_id: String) -> bool:
	var check := can_upgrade_skill(skill_id)
	if not bool(check.get("can_upgrade", false)):
		return false
	var cur_lvl: int = int(_saved_skill_levels.get(skill_id, 1))
	_saved_skill_points -= 1
	_saved_skill_levels[skill_id] = cur_lvl + 1
	save_progress()
	return true

## Reset toàn bộ điểm (tẩy điểm kỹ năng thủ thành)
static func reset_skills() -> void:
	load_progress()
	var refunded := 0
	for sid in _saved_skill_levels:
		var lvl: int = int(_saved_skill_levels[sid])
		if lvl > 1:
			refunded += (lvl - 1)
	_saved_skill_levels.clear()
	_saved_skill_points += refunded
	save_progress()

