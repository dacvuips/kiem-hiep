[node name="IntroDesc" type="Label" parent="DimControl/WelcomeDialog/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.92, 0.92, 1)
theme_override_constants/line_spacing = 4
theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 14
text = "Chào mừng Đại Hiệp bước chân vào chốn Võ Lâm Giang Hồ!
Để hành trình bôn tẩu thuận buồm xuôi gió, bổn trang xin phép hướng dẫn từng tính năng trọng yếu:
  • Bảng Thuộc Tính & Điểm Tiềm Năng
  • Rương Hành Trang & 12 Ô Trang Bị
  • Tuyệt Kỹ Võ Công Môn Phái Ngũ Hành
  • Lịch Trình Hoạt Động & Sự Kiện Lớn
  • Kỳ Trân Các & Dự Trữ Dược Phẩm
  • Khiêu Chiến Vượt Ải Bôn Tẩu Xuất Chinh

Đại hiệp có muốn bắt đầu tìm hiểu ngay bây giờ không?"
autowrap_mode = 2

